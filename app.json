{
  "expo": {
    "name": "SHËNDETI-IM",
    "slug": "shendeti-im",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#1a7a4a",
      "resizeMode": "contain"
    },
    "icon": "./assets/icons/logo.png",
    "adaptiveIcon": {
      "backgroundColor": "#1a7a4a",
      "foregroundImage": "./assets/icons/logo.png"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "package": "al.shendeti.im",
      "adaptiveIcon": {
        "backgroundColor": "#1a7a4a"
      },
      "permissions": ["CAMERA"]
    },
    "ios": {
      "bundleIdentifier": "al.shendeti.im"
    }
  }
}