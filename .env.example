# ─────────────────────────────────────────────────────────────
# SHËNDETI-IM — konfigurimi i AI LOKALE (Ollama)
# Kopjoje këtë skedar si ".env" dhe plotëso sipas nevojës.
# ─────────────────────────────────────────────────────────────

# Adresa e serverit Ollama.
#   Emulator Android : http://10.0.2.2:11434   (10.0.2.2 = localhost i PC-së)
#   Pajisje fizike   : http://192.168.1.50:11434  (IP-ja e PC-së në WiFi)
#   iOS simulator    : http://localhost:11434
# Nëse lihet bosh, aplikacioni e zgjedh automatikisht sipas platformës.
EXPO_PUBLIC_OLLAMA_URL=

# Modeli për bisedë dhe tekst (duhet tërhequr me "ollama pull <model>").
EXPO_PUBLIC_OLLAMA_MODEL=llama3.2

# Modeli për foto/fatura — duhet të mbështesë imazhe.
EXPO_PUBLIC_OLLAMA_VISION_MODEL=llava
